{
	"name": "dana",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"overrides": {
		"typebox": "1.1.6"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && tar -czvf build.tar.gz build/",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@better-auth/cli": "~1.4.21",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource-variable/manrope": "^5.2.8",
		"@fontsource-variable/roboto": "^5.2.10",
		"@fontsource-variable/space-grotesk": "^5.2.10",
		"@inlang/paraglide-js": "^2.18.2",
		"@internationalized/date": "^3.12.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tabler/icons-svelte": "^3.44.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^24",
		"@types/nodemailer": "^8.0.1",
		"better-auth": "~1.4.21",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"mysql2": "^3.20.0",
		"paneforge": "^1.0.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"shadcn-svelte": "^1.3.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"sveltekit-superforms": "^2.30.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"zod": "^4.4.3"
	},
	"dependencies": {
		"@fontsource-variable/noto-sans": "^5.2.10",
		"@friendofsvelte/tipex": "^0.1.1",
		"@google/genai": "^2.10.0",
		"@lucide/svelte": "^1.17.0",
		"@prgm/sveltekit-progress-bar": "^3.0.2",
		"@tanstack/table-core": "^8.21.3",
		"bits-ui": "^2.18.1",
		"browser-image-compression": "^2.0.2",
		"chapa-nodejs": "^2.1.1",
		"chart.js": "^4.5.1",
		"embla-carousel-autoplay": "^8.6.0",
		"jspdf": "^4.2.1",
		"jspdf-autotable": "^5.0.8",
		"mode-watcher": "^1.1.0",
		"nodemailer": "^8.0.10",
		"papaparse": "^5.5.3",
		"svelte-sonner": "^1.1.1",
		"sveltekit-flash-message": "^2.4.6"
	}
}
