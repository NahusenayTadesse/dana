# Test environment — loaded by Vite when mode === 'test' (overrides .env).
#
# NOTHING here may reach a real service. This file is committed (see .gitignore),
# so it must never carry a production secret.
#
#   Mail  -> Mailpit on localhost:1025, web UI + API on http://localhost:8025
#            docker run -d --name mailpit-dana -p 1025:1025 -p 8025:8025 axllent/mailpit
#   SMS   -> the harness intercepts global fetch, so api.geezsms.com is never
#            called. The key below is a placeholder that would fail anyway.
#   Chapa -> same: intercepted. Placeholder keys, not the live ones.

# --- Mail: captured by Mailpit, never delivered ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=sales@dana.test
SMTP_PASSWORD=test

# --- SMS: placeholder. GeezSMS charges per message; never point this at prod ---
SMS_KEY=test-sms-key-not-real

# --- Payments: placeholder. Never the live Chapa keys ---
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-placeholder
CHAPA_SECRET_KEY=CHASECK_TEST-placeholder
CHAPA_WEBHOOK_SECRET=test-webhook-secret

ORIGIN=http://localhost:5173
